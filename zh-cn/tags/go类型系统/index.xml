      <description>&lt;p&gt;下面这段代码输出什么？为什么？&lt;/p&gt;&#xA;&lt;pre&gt;&lt;code&gt;type People interface {&#xA;    Show()&#xA;}&#xA;&#xA;type Student struct{}&#xA;&#xA;func (stu *Student) Show() {&#xA;&#xA;}&#xA;&#xA;func main() {&#xA;&#xA;    var s *Student&#xA;    if s == nil {&#xA;        fmt.Println(&amp;#34;s is nil&amp;#34;)&#xA;    } else {&#xA;        fmt.Println(&amp;#34;s is not nil&amp;#34;)&#xA;    }&#xA;    var p People = s&#xA;    if p == nil {&#xA;        fmt.Println(&amp;#34;p is nil&amp;#34;)&#xA;    } else {&#xA;        fmt.Println(&amp;#34;p is not nil&amp;#34;)&#xA;    }&#xA;}&lt;/code&gt;&lt;/pre&gt;&#xA;&lt;details&gt;&#xA;  &lt;summary&gt;🔑 答案解析：&lt;/summary&gt;&#xA;  &lt;p&gt;参考答案及解析：s is nil 和 p is not nil。&lt;/p&gt;</description>
    </item>
