      <link>https://loommii.github.io/zh-cn/go_practise/go_daily_question_065/</link>
      <pubDate>Fri, 06 Dec 2024 20:44:47 +0800</pubDate>
      <guid>https://loommii.github.io/zh-cn/go_practise/go_daily_question_065/</guid>
      <category domain="https://loommii.github.io/zh-cn/categories/go%E6%AF%8F%E6%97%A5%E4%B8%80%E9%A2%98/">Go每日一题</category>
