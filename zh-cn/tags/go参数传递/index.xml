      <description>&lt;p&gt;下面这段代码输出什么？&lt;/p&gt;&#xA;&lt;pre&gt;&lt;code&gt;package main&#xA;&#xA;import &amp;#34;fmt&amp;#34;&#xA;&#xA;func change(s ...int) {&#xA;    s = append(s, 3)&#xA;}&#xA;&#xA;func main() {&#xA;    slice := make([]int, 5, 5)&#xA;    slice[0] = 1&#xA;    slice[1] = 2&#xA;    change(slice...)&#xA;    fmt.Println(slice)&#xA;    change(slice[0:2]...)&#xA;    fmt.Println(slice)&#xA;}&lt;/code&gt;&lt;/pre&gt;&#xA;&lt;details&gt;&#xA;  &lt;summary&gt;🔑 答案解析：&lt;/summary&gt;&#xA;  &lt;pre&gt;&lt;code&gt;[1 2 0 0 0]&#xA;[1 2 3 0 0]&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;&lt;a href=&#34;https://go.dev/play/p/sJ68ZpNd2Tj&#34; target=&#34;_blank&#34; rel=&#34;external nofollow noopener noreferrer&#34;&gt;Go在线运行&lt;/a&gt;&lt;/p&gt;</description>
