      <category domain="https://loommii.github.io/en/categories/golanguagebasics/">GoLanguageBasics</category>
      <description>&lt;p&gt;What is the output of the following code?&lt;/p&gt;&#xA;&lt;pre&gt;&lt;code&gt;package main&#xA;&#xA;import &amp;#34;fmt&amp;#34;&#xA;&#xA;func app() func(string) string {&#xA;    t := &amp;#34;Hi&amp;#34;&#xA;    c := func(b string) string {&#xA;        t = t &amp;#43; &amp;#34; &amp;#34; &amp;#43; b&#xA;        return t&#xA;    }&#xA;    return c&#xA;}&#xA;&#xA;func main() {&#xA;    a := app()&#xA;    b := app()&#xA;    a(&amp;#34;go&amp;#34;)&#xA;    fmt.Println(b(&amp;#34;All&amp;#34;))&#xA;    fmt.Println(a(&amp;#34;All&amp;#34;))&#xA;}&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;A: Hi All; B: Hi go All; C: Hi; D: go Al&#xA;&#xA;&lt;details&gt;&#xA;  &lt;summary&gt;🔑 Answer Analysis:&lt;/summary&gt;&#xA;  &lt;p&gt;Closure&#xA;&lt;code&gt;fmt.Println(b(&amp;quot;All&amp;quot;))&lt;/code&gt; outputs A (Hi All)&#xA;&lt;code&gt;fmt.Println(a(&amp;quot;All&amp;quot;))&lt;/code&gt; outputs B (Hi go All)&lt;/p&gt;</description>
