2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z"&gt;&lt;/path&gt;&lt;/svg&gt;&#10; &lt;/a&gt;&#10;&lt;/h2&gt;&lt;p&gt;&lt;code&gt;5/+-*v&lt;/code&gt;&#10;Go language &lt;a href="https://golang.google.cn/ref/spec#Operators" target="_blank" rel="external nofollow noopener noreferrer"&gt;operator precedence rules&lt;/a&gt;&lt;/p&gt;</description></item><item><title>Go Daily Question 222</title><link>https://loommii.github.io/en/go_practise/go_daily_question_222/</link><pubDate>Sat, 03 May 2025 00:37:04 +0800</pubDate><guid>https://loommii.github.io/en/go_practise/go_daily_question_222/</guid><category domain="https://loommii.github.io/en/categories/godailyquestion/">GoDailyQuestion</category><category domain="https://loommii.github.io/en/categories/golanguagebasics/">GoLanguageBasics</category><description>&lt;p&gt;Go101 author published a twitter. Will the following code run normally, and what is the result?&#10;What is the output of the following code?&lt;/p&gt;&#10;&lt;pre&gt;&lt;code&gt;package main&#10;&#10;func main() {&#10; v := new(int)&#10; *v = 2&#10; println(5/&amp;#43;-*v)&#10;}&lt;/code&gt;&lt;/pre&gt;&#10;&lt;details&gt;&#10; &lt;summary&gt;🔑 Answer Analysis:&lt;/summary&gt;&#10; &lt;p&gt;Reference Answer and Analysis: B.&lt;/p&gt;&#10;&lt;p&gt;Go has the following unary operators:&lt;/p&gt;&#10;&lt;pre&gt;&lt;code&gt;unary_op = &amp;#34;&amp;#43;&amp;#34; | &amp;#34;-&amp;#34; | &amp;#34;!&amp;#34; | &amp;#34;^&amp;#34; | &amp;#34;*&amp;#34; | &amp;#34;&amp;amp;&amp;#34; | &amp;#34;&amp;lt;-&amp;#34; .&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;Therefore, &lt;code&gt;5/+-*v&lt;/code&gt; will be calculated first.&#10;Also, according to the specification:&lt;/p&gt;</description></item><item><title>Go Daily Question 209</title><link>https://loommii.github.io/en/go_practise/go_daily_question_209/</link><pubDate>Mon, 10 Mar 2025 11:03:42 +0800</pubDate><guid>https://loommii.github.io/en/go_practise/go_daily_question_209/</guid><category domain="https://loommii.github.io/en/categories/godailyquestion/">GoDailyQuestion</category><category domain="https://loommii.github.io/en/categories/golanguagebasics/">GoLanguageBasics</category><description>&lt;p&gt;What is the output of the following code?&lt;/p&gt;&#10;&lt;pre&gt;&lt;code&gt;package main&#10;&#10;import &amp;#34;fmt&amp;#34;&#10;&#10;func main() {&#10; var a, b float64 = 1.0, 4.0&#10; fmt.Println(a | b)&#10;}&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;A: 5&#10;B: +Inf&#10;C: panic&#10;D: Cannot compile&lt;/p&gt;&#10;&#10;&lt;details&gt;&#10; &lt;summary&gt;🔑 Answer Analysis:&lt;/summary&gt;&#10; &lt;p&gt;D Cannot compile&lt;/p&gt;&#10;&lt;p&gt;&lt;a href="https://go.dev/play/p/lLMbGE_ajrg" target="_blank" rel="external nofollow noopener noreferrer"&gt;Run online&lt;/a&gt;&lt;/p&gt;&#10;&lt;p&gt;The &lt;code&gt;|&lt;/code&gt; operator is a bitwise OR operator, and its operands can only be integers. In the problem above, the operands are &lt;code&gt;float64&lt;/code&gt;, so it will not compile.&#10;Compilation error message:&lt;/p&gt;</description></item><item><title>Go Daily Question 159</title><link>https://loommii.github.io/en/go_practise/go_daily_question_159/</link><pubDate>Sun, 12 Jan 2025 15:25:17 +0800</pubDate><guid>https://loommii.github.io/en/go_practise/go_daily_question_159/</guid><category domain="https://loommii.github.io/en/categories/godailyquestion/">GoDailyQuestion</category><category domain="https://loommii.github.io/en/categories/golanguagebasics/">GoLanguageBasics</category><description>&lt;p&gt;Will the following code run normally, and what is the result?&lt;/p&gt;&#10;&lt;pre&gt;&lt;code&gt;package main&#10;&#10;func main() {&#10; v := new(int)&#10; *v = 2&#10; println(5/&amp;#43;-*v)&#10;}&lt;/code&gt;&lt;/pre&gt;&#10;&lt;details&gt;&#10; &lt;summary&gt;🔑 Answer Analysis:&lt;/summary&gt;&#10; &lt;p&gt;It runs normally and the result is -2.&lt;/p&gt;&#10;&lt;p&gt;&lt;a href="https://go.dev/play/p/5A8BdXFzaOf" target="_blank" rel="external nofollow noopener noreferrer"&gt;Run online&lt;/a&gt;&lt;/p&gt;&#10;&lt;h2 class="heading-element" id="expression-parsing"&gt;&lt;span&gt;Expression Parsing&lt;/span&gt;&#10; &lt;a href="#expression-parsing" class="heading-mark"&gt;&#10; &lt;svg class="octicon octicon-link" viewBox="0 0 16 16" version="1.1" width="16" height="16" aria-hidden="true"&gt;&lt;path d="m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z"&gt;&lt;/path&gt;&lt;/svg&gt;&#10; &lt;/a&gt;&#10;&lt;/h2&gt;&lt;p&gt;&lt;code&gt;5/+-*v&lt;/code&gt;&#10;Go language &lt;a href="https://golang.google.cn/ref/spec#Operators" target="_blank" rel="external nofollow noopener noreferrer"&gt;operator precedence rules&lt;/a&gt;&lt;/p&gt;</description></item><item><title>Go Daily Question 122</title><link>https://loommii.github.io/en/go_practise/go_daily_question_122/</link><pubDate>Fri, 06 Dec 2024 23:43:05 +0800</pubDate><guid>https://loommii.github.io/en/go_practise/go_daily_question_122/</guid><category domain="https://loommii.github.io/en/categories/godailyquestion/">GoDailyQuestion</category><category domain="https://loommii.github.io/en/categories/golanguagebasics/">GoLanguageBasics</category><description>&lt;p&gt;What is the output of the following code?&lt;/p&gt;&#10;&lt;pre&gt;&lt;code&gt;func main() {&#10; var ans float64 = 15 &amp;#43; 25 &amp;#43; 5.2&#10; fmt.Println(ans)&#10;}&lt;/code&gt;&lt;/pre&gt;&#10;&lt;details&gt;&#10; &lt;summary&gt;🔑 Answer Analysis:&lt;/summary&gt;&#10; &lt;p&gt;Answer: 45.2&lt;/p&gt;&#10;&lt;/details&gt;</description></item><item><title>Go Daily Question 118</title><link>https://loommii.github.io/en/go_practise/go_daily_question_118/</link><pubDate>Fri, 06 Dec 2024 23:43:00 +0800</pubDate><guid>https://loommii.github.io/en/go_practise/go_daily_question_118/</guid><category domain="https://loommii.github.io/en/categories/godailyquestion/">GoDailyQuestion</category><category domain="https://loommii.github.io/en/categories/golanguagebasics/">GoLanguageBasics</category><description>&lt;p&gt;A tweet published by Go101. Will the following code run normally, and what is the result?&#10;What is the output of the following code?&lt;/p&gt;&#10;&lt;pre&gt;&lt;code&gt;package main&#10;&#10;func main() {&#10; v := new(int)&#10; *v = 2&#10; println(5/&amp;#43;-*v)&#10;}&lt;/code&gt;&lt;/pre&gt;&#10;&lt;details&gt;&#10; &lt;summary&gt;🔑 Answer Analysis:&lt;/summary&gt;&#10; &lt;p&gt;Reference Answer and Analysis: B.&lt;/p&gt;&#10;&lt;p&gt;Go has the following unary operators:&lt;/p&gt;&#10;&lt;pre&gt;&lt;code&gt;unary_op = &amp;#34;&amp;#43;&amp;#34; | &amp;#34;-&amp;#34; | &amp;#34;!&amp;#34; | &amp;#34;^&amp;#34; | &amp;#34;*&amp;#34; | &amp;#34;&amp;amp;&amp;#34; | &amp;#34;&amp;lt;-&amp;#34; .&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;Therefore, &lt;code&gt;5/+-*v&lt;/code&gt; will be calculated first.&#10;Also, according to the specification:&lt;/p&gt;</description></item><item><title>Go Daily Question 081</title><link>https://loommii.github.io/en/go_practise/go_daily_question_081/</link><pubDate>Fri, 06 Dec 2024 20:45:06 +0800</pubDate><guid>https://loommii.github.io/en/go_practise/go_daily_question_081/</guid><category domain="https://loommii.github.io/en/categories/godailyquestion/">GoDailyQuestion</category><category domain="https://loommii.github.io/en/categories/golanguagebasics/">GoLanguageBasics</category><description>&lt;p&gt;What is the output of the following code?&lt;/p&gt;&#10;&lt;pre&gt;&lt;code&gt;package main&#10;&#10;import (&#10; &amp;#34;fmt&amp;#34;&#10;)&#10;&#10;func main() {&#10; var ans float64 = 15 &amp;#43; 25 &amp;#43; 5.2&#10; fmt.Println(ans)&#10;}&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;A: Cannot compile; B: 45; C: 45.2; D: 45.0&lt;/p&gt;&#10;&#10;&lt;details&gt;&#10; &lt;summary&gt;🔑 Answer Analysis:&lt;/summary&gt;&#10; &lt;p&gt;C&#10;Numbers are untyped constants.&#10;Or rather, they are arbitrary types.&lt;/p&gt;&#10;&lt;/details&gt;</description></item><item><title>Go Daily Question 042</title><link>https://loommii.github.io/en/go_practise/go_daily_question_042/</link><pubDate>Fri, 06 Dec 2024 20:44:20 +0800</pubDate><guid>https://loommii.github.io/en/go_practise/go_daily_question_042/</guid><category domain="https://loommii.github.io/en/categories/godailyquestion/">GoDailyQuestion</category><category domain="https://loommii.github.io/en/categories/golanguagebasics/">GoLanguageBasics</category><description>&lt;p&gt;What is the output of the following code?&lt;/p&gt;&#10;&lt;pre&gt;&lt;code&gt;func main() { &#10; a := 5&#10; b := 8.1&#10; fmt.Println(a &amp;#43; b)&#10;}&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;A.13.1&#10;B.13&#10;C.compilation error&lt;/p&gt;&#10;&#10;&lt;details&gt;&#10; &lt;summary&gt;🔑 Answer Analysis:&lt;/summary&gt;&#10; &lt;p&gt;Reference Answer and Analysis: C. The type of &lt;code&gt;a&lt;/code&gt; is &lt;code&gt;int&lt;/code&gt;, and the type of &lt;code&gt;b&lt;/code&gt; is &lt;code&gt;float&lt;/code&gt;. Two numerical values of different types cannot be added, resulting in a compilation error.&lt;/p&gt;&#10;&lt;/details&gt;</description></item></channel></rss>